{
  "name": "@supersuit/tile-app-md",
  "version": "0.1.0",
  "description": "A written standard for a tile app's app.json, the front door Supersuit's Helm reads: a checker that applies the host's own rules, and a stamp that names the standard by a minimal textual edit.",
  "keywords": ["tile-app", "helm", "supersuit", "app.json", "records", "hypercontext", "agents"],
  "type": "module",
  "bin": { "tile-app-md": "bin/tile-app-md.mjs" },
  "exports": { ".": "./src/index.mjs", "./package.json": "./package.json" },
  "files": ["bin/", "src/", "docs/", "standards/", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "mutation-check": "node scripts/mutation-check.mjs",
    "install-proof": "node scripts/install-proof.mjs"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/SupersuitUp/hypercontext.git", "directory": "packages/tile-app-md" },
  "dependencies": { "@supersuit/hypercontext-core": "^0.1.0" }
}
