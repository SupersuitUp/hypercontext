  "description": "A written standard for a session checkpoint: one file per save under checkpoints/, its facts in a YAML header, with a checker and a stamp.",
  "keywords": ["checkpoint", "save-log", "sessions", "markdown", "frontmatter", "records", "hypercontext", "agents"],
  "type": "module",
  "bin": { "checkpoint-md": "bin/checkpoint-md.mjs" },
