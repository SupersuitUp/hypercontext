{
  "name": "@supersuit/friend-md",
  "version": "0.3.0",
  "description": "Read, write, validate and convert portable friend.md relationship records.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./python": "./python/freedom_people.py",
    "./standards/friend/v1.json": "./standards/friend/v1.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "friend-md": "bin/friend-md.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "python/freedom_people.py",
    "docs/",
    "standards/",
    "LICENSE",
    "README.md",
    "SOURCE.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:package": "node --test tests/packed-install.test.mjs",
    "prepublishOnly": "npm test && npm run test:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SupersuitUp/friend-md.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "friend-md",
    "markdown",
    "people",
    "relationships"
  ]
}
