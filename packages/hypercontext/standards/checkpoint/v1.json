{
  "manifest_version": 1,
  "standard": "https://hypercontext.wiki/standards/checkpoint/v1",
  "kind": "checkpoint",
  "version": 1,
  "title": "A session checkpoint",
  "status": "current",
  "superseded_by": null,
  "latest": "https://hypercontext.wiki/standards/checkpoint",
  "record": {
    "path": "checkpoints/YYYY-MM-DD-HHMMSS-<slug>.md",
    "format": "md"
  },
  "header": {
    "required": [
      "standard",
      "kind",
      "summary"
    ],
    "keys": {
      "standard": {
        "const": "https://hypercontext.wiki/standards/checkpoint/v1"
      },
      "kind": {
        "const": "checkpoint"
      },
      "summary": {
        "type": "string"
      },
      "date": {
        "type": "string"
      },
      "sha": {
        "type": "string"
      }
    }
  },
  "validator": null,
  "checked_by": {
    "package": "@supersuit/hypercontext",
    "implements_since": "0.1.0",
    "check": "npx -y @supersuit/hypercontext@^0.1.0 check . --kind checkpoint --json",
    "backfill": "npx -y @supersuit/hypercontext@^0.1.0 stamp . --kind checkpoint --apply",
    "note": "No package checks this shape yet; only the shared property (the record names this standard) is checked."
  },
  "codes": [
    {
      "code": "self-doc:missing",
      "level": "error",
      "means": "the record names no standard, the unversioned URL written before versions, or another kind's standard",
      "fix": "npx -y @supersuit/hypercontext@^0.1.0 stamp . --kind checkpoint --apply"
    },
    {
      "code": "self-doc:version",
      "level": "error",
      "means": "the record names a version of this standard that the checker here does not implement",
      "fix": "upgrade @supersuit/hypercontext, or rewrite the record to a version it implements"
    }
  ],
  "umbrella": "npx -y @supersuit/hypercontext check <workspace>"
}
