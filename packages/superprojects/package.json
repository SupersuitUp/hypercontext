{
  "name": "@supersuit/superprojects",
  "version": "0.7.0",
  "description": "Superprojects: portable Markdown projects an agent can carry, with an atomic action map, an on-track answer, verified context and sharing checks",
  "type": "module",
  "bin": {
    "superprojects": "bin/superprojects.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "mutation-check": "node scripts/mutation-check.mjs",
    "install-proof": "node scripts/install-proof.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SupersuitUp/superprojects.git"
  },
  "dependencies": {}
}
