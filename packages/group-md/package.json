{
  "name": "@supersuit/group-md",
  "version": "0.2.0",
  "description": "A written standard for the record of a group of people and its chat threads, with a checker, a finder and a reconciler.",
  "keywords": [
    "group",
    "chat",
    "markdown",
    "frontmatter",
    "records",
    "agents"
  ],
  "type": "module",
  "bin": {
    "group-md": "bin/group-md.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json",
    "./standards/group/v1.json": "./standards/group/v1.json"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "standards/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "mutation-check": "node scripts/mutation-check.mjs",
    "install-proof": "node scripts/install-proof.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SupersuitUp/group-md.git"
  },
  "dependencies": {}
}
