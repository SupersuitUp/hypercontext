{
  "name": "@supersuit/superobjective",
  "version": "0.1.0",
  "description": "A written standard for a superobjective: one sentence, true or false by an exact date about a year away, with its signs, an append-only ratchet log, and the gates that keep it from drifting or being lowered quietly.",
  "keywords": ["superobjective", "goals", "okr", "markdown", "frontmatter", "records", "hypercontext", "agents", "supersuit"],
  "type": "module",
  "bin": { "superobjective": "bin/superobjective.mjs" },
  "exports": { ".": "./src/index.mjs", "./package.json": "./package.json" },
  "files": ["bin/", "src/", "docs/", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "mutation-check": "node scripts/mutation-check.mjs",
    "install-proof": "node scripts/install-proof.mjs"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/SupersuitUp/superobjective.git" },
  "dependencies": {}
}
