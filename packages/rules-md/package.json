{
  "name": "@supersuit/rules-md",
  "version": "0.1.0",
  "description": "A written standard for agent rules: every rule in a rules file (AGENTS.md, CLAUDE.md) carries a stable id, and a why file says why each one exists, with a checker that holds the two in step and flags a rule reworded since its story was read.",
  "keywords": ["agents", "agents.md", "claude.md", "rules", "instructions", "markdown", "records", "hypercontext"],
  "type": "module",
  "bin": { "rules-md": "bin/rules-md.mjs" },
  "exports": { ".": "./src/index.mjs", "./package.json": "./package.json" },
  "files": ["bin/", "src/", "docs/", "standards/", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "mutation-check": "node scripts/mutation-check.mjs"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/SupersuitUp/hypercontext.git", "directory": "packages/rules-md" },
  "dependencies": { "@supersuit/hypercontext-core": "^0.1.0" }
}
