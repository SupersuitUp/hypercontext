{
  "name": "@supersuit/self-md",
  "version": "0.2.0",
  "description": "A written standard for the folder that holds everything about one person (self/), with a lint that enforces it and a sweep that derives which tools read each file.",
  "type": "module",
  "bin": {
    "self-md": "bin/self-md.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./standards/self/v1.json": "./standards/self/v1.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "standards/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SupersuitUp/self-md.git"
  },
  "dependencies": {},
  "keywords": [
    "self",
    "markdown",
    "lint",
    "frontmatter",
    "read_by",
    "personal-workspace"
  ]
}
