{
  "name": "@supersuit/document-md",
  "version": "0.1.0",
  "description": "A written standard for a document in a workspace's documents/ folder: a stamped markdown file whose YAML header names its standard and who it is for, with a checker and a byte-preserving stamp.",
  "keywords": ["document", "markdown", "frontmatter", "records", "hypercontext", "supersuit", "agents"],
  "type": "module",
  "bin": { "document-md": "bin/document-md.mjs" },
  "exports": { ".": "./src/index.mjs", "./package.json": "./package.json" },
  "files": ["bin/", "src/", "standards/", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "mutation-check": "node scripts/mutation-check.mjs",
    "install-proof": "node scripts/install-proof.mjs"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/SupersuitUp/hypercontext.git", "directory": "packages/document-md" },
  "dependencies": { "@supersuit/hypercontext-core": "^0.1.0" }
}
